{
  "name": "CSwL — Lean 4",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",

  // `onCreateCommand` (e não `postCreate`) roda durante o prebuild do
  // Codespaces. Com prebuild ligado nas configurações do repositório, a Mathlib
  // compilada e o projeto já vêm prontos na imagem, e o Codespace abre em
  // segundos em vez de minutos.
  "onCreateCommand": "lake exe cache get && lake build",
  "waitFor": "onCreateCommand",

  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "64gb"
  },

  "customizations": {
    "vscode": {
      "extensions": ["leanprover.lean4"]
    }
  },

  // Garante o elan no PATH também para a extensão do Lean, que não passa pelo
  // shell de login.
  "remoteEnv": {
    "PATH": "/home/vscode/.elan/bin:${containerEnv:PATH}"
  },

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Livro (Verso) — ./serve.py", "onAutoForward": "silent" }
  }
}
